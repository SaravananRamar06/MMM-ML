# encoding: utf-8
# 2026 R1
SetScriptVersion(Version="26.1.174")
system1 = GetSystem(Name="SYS 1")
modelComponent1 = system1.GetComponent(Name="Model")
modelComponent1.Refresh()
model1 = system1.GetContainer(ComponentName="Model")
model1.Edit()
system1.Copy(KeepConnections=True)
system2 = GetSystem(Name="SYS 2")
system2.Delete()
template1 = GetTemplate(
    TemplateName="Static Structural",
    Solver="ANSYS")
system3 = template1.CreateSystem(
    Position="Right",
    RelativeTo=system1)
favorites1 = EngData.LoadFavoriteItems()
library1 = EngData.OpenLibrary(
    Name="Additive Manufacturing Materials",
    Source="Additive_Manufacturing_Materials.xml")
engineeringData1 = system3.GetContainer(ComponentName="Engineering Data")
matl1 = engineeringData1.ImportMaterial(
    Name="AlSi10Mg",
    Source="Additive_Manufacturing_Materials.xml")
material1 = engineeringData1.GetMaterial(Name="Structural Steel")
material1.Delete()
matl1.DisplayName = "AlSi10Mg - E"
matlProp1 = matl1.GetProperty(Name="Isotropic Hardening")
matlProp1.Delete(Definition="Bilinear")
matlProp2 = matl1.GetProperty(Name="Norton")
matlProp2.Delete()
Save(Overwrite=True)
Save(Overwrite=True)
geometry1 = system3.GetContainer(ComponentName="Geometry")
geometry1.Edit(IsDiscoveryGeometry=True)
model1.Exit()
geometry1.Exit()
modelComponent2 = system3.GetComponent(Name="Model")
modelComponent2.Refresh()
model2 = system3.GetContainer(ComponentName="Model")
model2.Edit()
model1.Edit()
model1.Exit()
Save(Overwrite=True)
Save(Overwrite=True)
system1.Delete()
system3.DisplayText = "Elastic"
Save(Overwrite=True)
Save(Overwrite=True)
system4 = GetSystem(Name="SYS")
model3 = system4.GetContainer(ComponentName="Model")
model3.Edit()
Save(Overwrite=True)
Save(Overwrite=True)
Save(Overwrite=True)
Save(Overwrite=True)
model2.Exit()
model3.Exit()
Save(Overwrite=True)
