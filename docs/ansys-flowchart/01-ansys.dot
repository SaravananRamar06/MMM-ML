digraph ANSYS {
  graph [rankdir=TB, bgcolor="white", pad=0.35, nodesep=0.5, ranksep=0.55,
    fontname="Arial", fontsize=22, labelloc=t,
    label="A · ANSYS bracket solution\nGlobal equilibrium and load-substep control"];
  node [shape=box, style="rounded,filled", fillcolor="#edf4fb", color="#315d84",
    fontname="Arial", fontsize=13, margin="0.20,0.14", penwidth=1.3];
  edge [fontname="Arial", fontsize=11, color="#42566b", arrowsize=0.8];

  setup [label="Prepare the actual project geometry, mesh and boundary conditions\nSet the imposed-displacement history and solver controls\nLoad the compiled USERMAT library through ANS_USER_PATH\nDefine TB,USER properties and at least four TB,STATE variables"];
  start [label="Begin or retry a load substep\nUse the last accepted stress and material history"];
  propose [label="ANSYS predicts / corrects the nodal displacement solution"];
  strain [label="Compute strain increments at integration points\nrelative to the start of this substep"];
  local [label="Call USERMAT for the local material update → view B\nThe JC-PINN evaluator inside it is expanded in view C",
    fillcolor="#e9f5f0", color="#28735d"];
  result [shape=diamond, label="Local update\nresult?", style=filled];
  assemble [label="For successful local updates: assemble element contributions\ninto the global internal-force residual and tangent stiffness"];
  equilibrium [shape=diamond, label="Global convergence\ncriteria satisfied?", style=filled];
  another [shape=diamond, label="Continue equilibrium\niterations under the\nsolver controls?", style=filled];
  recovery [shape=diamond, label="Cutback / retry permitted\nby ANSYS controls and\nminimum substep size?", style=filled, fillcolor="#fff5df", color="#936818"];
  cutback [label="Reject the failed trial substep\nBisect / reduce the substep and retry\nfrom the last converged state", fillcolor="#fff5df", color="#936818"];
  accept [label="Accept the converged substep\nCommit its material history and save requested results"];
  complete [shape=diamond, label="Prescribed loading\ncomplete?", style=filled];
  next [label="Select the next load substep\nusing the configured stepping controls"];
  output [label="Completed analysis\nDisplacements · stresses · plastic strains · reactions\nUSERMAT state variables, where requested",
    shape=box, fillcolor="#e9f5f0", color="#28735d"];
  failed [label="Stop / report nonconvergence\nRetain only previously accepted results", fillcolor="#fceeed", color="#a43d36"];
  error [label="Report a material error through ANSYS erhandler\nThis local update is not a successful return\nSee explicit error paths in B and C", fillcolor="#fceeed", color="#a43d36"];
  notes [shape=note, fillcolor="#f7f7f7", color="#8a939c", fontsize=12,
    label="Scope\nSmall-strain structural analysis; no training inside the solve.\nThe saved bracket study uses imposed UX, not an invented service force.\nGlobal iteration / recovery policy belongs to ANSYS, not to the neural network.\nA successful solve is not experimental validation or mesh convergence."];

  setup -> start -> propose -> strain -> local -> result;
  result -> assemble [label="success: ISTAT = 0"];
  result -> recovery [label="local nonconvergence:\nkeycut = 1", color="#936818"];
  result -> error [label="material / interface error", color="#a43d36"];
  assemble -> equilibrium;
  equilibrium -> accept [label="yes"];
  equilibrium -> another [label="no"];
  another -> propose [label="yes: revise displacements", constraint=false];
  another -> recovery [label="no / recovery needed"];
  recovery -> cutback [label="yes"];
  recovery -> failed [label="no"];
  cutback -> start [label="retry smaller substep", constraint=false, color="#936818"];
  accept -> complete;
  complete -> output [label="yes"];
  complete -> next [label="no"];
  next -> start [label="advance loading", constraint=false];
  output -> notes [style=invis];
}
