digraph RETURN_MAPPING {
  graph [rankdir=TB, bgcolor="white", pad=0.35, nodesep=0.45, ranksep=0.5,
    fontname="Arial", fontsize=22, labelloc=t,
    label="D · Plastic radial return in JCPRM\nLocal iteration details, expanded from view B"];
  node [shape=box, style="rounded,filled", fillcolor="#e9f5f0", color="#28735d",
    fontname="Arial", fontsize=13, margin="0.20,0.14", penwidth=1.3];
  edge [fontname="Arial", fontsize=11, color="#42566b", arrowsize=0.8];

  init [label="Enter only after trial stress exceeds the initial flow stress\nInitialise once: dp = 0; lo = 0; hi = q_trial / (3Ge); iteration = 1"];
  evaluate [label="Call JCPFLW at p + dp → view C\nGet flow stress sy, slope H and current evaluation flags"];
  valid [shape=diamond, style=filled, label="Evaluation successful?"];
  err2 [label="ISTAT = 2\nReturn material error to B", fillcolor="#fceeed", color="#a43d36"];
  residual [label="Compute consistency residual\nr = q_trial - 3Ge * dp - sy"];
  converged [shape=diamond, style=filled, label="abs(r) <= 1e-12 * sy?"];
  update [label="Update bracket: if r > 0, lo = dp; otherwise hi = dp\nTry Newton candidate: dp_new = dp + r / (3Ge + H)\nIf 3Ge + H <= 0 or candidate is not strictly inside (lo, hi),\nreplace candidate with 0.5 * (lo + hi). Set dp = dp_new."];
  exhausted [shape=diamond, style=filled, label="50 local evaluations\nexhausted?"];
  increment [label="Increment local iteration counter\nRetain the current lo / hi bracket"];
  cut [label="ISTAT = 1: did not converge\nReturn to B; wrapper sets keycut = 1\nANSYS substep recovery is shown in A",
    fillcolor="#fff5df", color="#936818"];
  slope [shape=diamond, style=filled, label="At the converged state:\n3Ge + H > 0?"];
  err3 [label="ISTAT = 3\nReturn material error to B", fillcolor="#fceeed", color="#a43d36"];
  flags [label="Merge this converged evaluation's flags into history\nIntermediate rejected Newton evaluations do not become history"];
  stress [label="Radial stress correction\nPreserve trial hydrostatic stress; scale trial deviatoric stress to sy\nCompute the consistent tangent using sy, q_trial, Ge, H and flow direction"];
  success [label="Return ISTAT = 0, corrected stress, tangent and dp to B\nWrapper then updates plastic-strain tensor, energies and state variables"];
  note [shape=note, fillcolor="#f7f7f7", color="#8a939c", fontsize=12,
    label="p = start-of-substep equivalent plastic strain; dp = plastic multiplier increment.\nGe is the elastic shear modulus, which can differ from the model's G input.\nThe final unused candidate on an exhausted iteration is not accepted.\nThis local loop is separate from ANSYS global equilibrium iterations."];

  init -> evaluate -> valid;
  valid -> err2 [label="no", color="#a43d36"];
  valid -> residual [label="yes"];
  residual -> converged;
  converged -> flags [label="yes"];
  converged -> update [label="no"];
  update -> exhausted;
  exhausted -> cut [label="yes", color="#936818"];
  exhausted -> increment [label="no"];
  increment -> evaluate [label="next evaluation", constraint=false];
  slope -> err3 [label="no", color="#a43d36"];
  flags -> slope;
  slope -> stress [label="yes"];
  stress -> success;
  success -> note [style=invis];
  {rank=same; valid; err2;}
  {rank=same; slope; err3;}
}
